{
  "name": "ecommers-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend --legacy-peer-deps && npm install --prefix backend --legacy-peer-deps",
    "dev:frontend": "npm start --prefix frontend",
    "dev:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend --legacy-peer-deps",
    "build:backend": "npm run build --prefix backend --legacy-peer-deps",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
